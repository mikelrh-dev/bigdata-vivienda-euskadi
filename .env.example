# ─────────────────────────────────────────────────────────────
# Entorno del proyecto BigDataReto
# Copia este fichero a .env y rellena los valores reales.
# ─────────────────────────────────────────────────────────────

# Salida de datos (relativa a la raiz del proyecto)
DATA_DIR=data

# ─── Kafka (clúster centro) ──────────────────────────────────
# Cadena vigente: Windows -> Kafka centro -> Hadoop.
KAFKA_BOOTSTRAP_SERVERS=10.22.87.215:9092
KAFKA_GROUP_ID=hdfs_centro
KAFKA_IDLE_MS=10000
KAFKA_TOPIC=vivienda_euskadi
# Topic vivienda_euskadi en 10.22.87.215:9092: 1 partición, RF 1
# (single node, sin alta disponibilidad; justificadо en docs).
# storage/kafka_topic.py los lee con getenv; sin declarar aquí la
# gobernanza (verificar_gobernanza) cuenta env usada sin declarar.
KAFKA_NUM_PARTITIONS=1
KAFKA_REPLICATION_FACTOR=1

# ─── Legacy VM ZooKeeper (no usar en la cadena vigente) ──────
# VM_HOST=192.168.201.162
# VM_KAFKA_PORT=9094

# ─── MongoDB (Docker en Windows) ─────────────────────────────
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=vivienda_euskadi
MONGO_TEST_DB=vivienda_euskadi_test
# MONGO_URI opcional; si se define, tiene prioridad sobre HOST/PORT.
MONGO_URI=

# ─── Gates y guardrails ─────────────────────────────────────
# GATE_LIVE=1 activa los chequeos en vivo de gate_extremo_a_extremo.py.
GATE_LIVE=
# RAW_GUARD_AUDIT_LOG: ruta opcional del log de transform/_raw_guard.py.
RAW_GUARD_AUDIT_LOG=

# ─── HDFS (Clúster centro) ────────────────────────────────
HDFS_URL=http://10.22.87.215:50070
HDFS_USER=iabd-user15
# HDFS_BASE_PATH: legacy, sin uso en la cadena vigente.
HDFS_BASE_PATH=/user/iabd-user15/bigdata_reto/vivienda_euskadi/data

# ─── API keys ────────────────────────────────────────────────
# Solo si te la han concedido. Déjala vacía si no la tienes.
# IDEALISTA_API_KEY: legacy, sin uso en la cadena vigente.
IDEALISTA_API_KEY=
REALTYAPI_KEY=

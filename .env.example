# ─────────────────────────────────────────────────────────────
# Entorno del proyecto BigDataReto
# Copia este fichero a .env y rellena los valores reales.
# ─────────────────────────────────────────────────────────────

# Salida de datos (relativa a la raiz del proyecto)
DATA_DIR=data

# ─── Ubuntu Server VM (Kafka) ────────────────────────────────
# IP de la VM (mejor fija). Debe ser alcanzable desde Windows. VM ZooKeeper 192.168.201.162 puerto 9094.
VM_HOST=192.168.201.162
VM_KAFKA_PORT=9094
KAFKA_TOPIC=anuncios_inmobiliarios

# ─── MongoDB (Docker en Windows) ─────────────────────────────
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=vivienda_euskadi

# ─── HDFS (Clúster centro) ────────────────────────────────
HDFS_URL=http://10.22.87.215:50070
HDFS_USER=iabd-user15
HDFS_BASE_PATH=/user/iabd-user15/bigdata_reto/vivienda_euskadi/data

# ─── API keys ────────────────────────────────────────────────
# Solo si te la han concedido. Déjala vacía si no la tienes.
IDEALISTA_API_KEY=
REALTYAPI_KEY=
